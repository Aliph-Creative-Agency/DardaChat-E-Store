{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:status": "tsx scripts/db.ts status",
    "db:push": "drizzle-kit push --force",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset --seed",
    "jobs": "tsx scripts/jobs.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@google/genai": "^2.24.0",
    "@node-rs/argon2": "^2.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "libphonenumber-js": "^1.13.14",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "otplib": "^13.5.0",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
