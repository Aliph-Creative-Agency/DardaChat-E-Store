# DardaChat web — environment. Copy to .env.local (gitignored) and adjust.
# Ports: each team has its own (see .orchestration/PLAN.md). main/platform = PG 54320, web 3000.
PG_PORT=54320
WEB_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:54320/dardachat
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54320/dardachat_test
APP_URL=http://localhost:3000

# Session signing secret (>= 32 random chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# LLM (optional). Empty = deterministic mock assistant.
GEMINI_API_KEY=

# Local object storage (mock S3). Relative to web/.
STORAGE_DIR=storage

# Mock payment provider webhook HMAC secret.
PAYMENT_WEBHOOK_SECRET=change-me

# Seed back-office accounts. Passwords are generated by `npm run db:seed` and written to .env.local only.
SEED_OWNER_EMAIL=owner@dardachat.local
SEED_STAFF_EMAIL=staff@dardachat.local
SEED_OWNER_PASSWORD=
SEED_STAFF_PASSWORD=
